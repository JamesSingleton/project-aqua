# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
# Server-side auth base URL (emails, OAuth callbacks). Use your machine's LAN IP when testing from other devices.
BETTER_AUTH_URL=http://localhost:3001
# Optional in local dev — the browser client uses window.location.origin so LAN sign-in works.
# Set in production to your public app URL.
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
# Marketing site (sign-out redirect). Local dev: apps/web on :3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
# Comma-separated extra origins (production). Dev trusts the request Origin automatically.
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Project Aqua <onboarding@resend.dev>

# Polar (Aqua SaaS — teams pay Aqua via Better Auth plugin)
# Webhook URL: {BETTER_AUTH_URL}/api/auth/polar/webhooks
# Leave blank locally — signup works without Polar. Paid checkout needs a sandbox token.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_ENTERPRISE=
POLAR_SERVER=sandbox

# Stripe (legacy helpers — SaaS checkout is Polar)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# USA Swimming
USA_SWIMMING_VENDOR_THUMBPRINT=
USA_SWIMMING_API_URL=

# Calendar OAuth + sign-in (optional — enables Google/Outlook sync and social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# OpenAI (workout AI suggestions)
OPENAI_API_KEY=

# Supabase (Storage — server-only uploads via @project-aqua/storage)
# Local: supabase status → API URL + service_role key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
