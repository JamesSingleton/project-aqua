{
  "name": "project-aqua",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "dev:admin": "turbo dev --filter=@project-aqua/admin",
    "dev:web": "turbo dev --filter=@project-aqua/web",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "db:migrate": "cd packages/database && npx drizzle-kit migrate",
    "db:generate": "cd packages/database && npx drizzle-kit generate",
    "db:pull": "cd packages/database && npx drizzle-kit pull",
    "db:push": "cd packages/database && npx drizzle-kit push",
    "db:studio": "cd packages/database && npx drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@project-aqua/typescript-config": "workspace:*",
    "@turbo/gen": "^2.8.21",
    "turbo": "^2.8.21",
    "ultracite": "^7.3.2"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
